# Copy to .env and fill in. .env is gitignored.

# Snowflake
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_ROLE=
SNOWFLAKE_WAREHOUSE=COMPUTE_WH
SNOWFLAKE_DATABASE=RETAIL_DB
SNOWFLAKE_PRIVATE_KEY_PATH=/opt/airflow/keys/rsa_key.p8

# Azurite (local Azure Blob emulator; public dev key, safe to share)

AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=http;AccountName=devstoreaccount1;AccountKey=Eby8vd...;BlobEndpoint=http://host.docker.internal:10000/devstoreaccount1;
AZURE_CONTAINER=retail-landing

# AWS (S3 bucket for the external stage path)

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
S3_BUCKET=

PROJECT_DIR=/opt/airflow/project
