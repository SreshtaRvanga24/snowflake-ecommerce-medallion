# Copy to .env and fill in. .env is gitignored.

# Snowflake
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_ROLE=
SNOWFLAKE_WAREHOUSE=
SNOWFLAKE_DATABASE=
SNOWFLAKE_PRIVATE_KEY_PATH=

# Azurite (local Azure Blob emulator; public dev key, safe to share)
AZURE_STORAGE_CONNECTION_STRING=
AZURE_CONTAINER=

# AWS (S3 bucket for the external stage path)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
S3_BUCKET=
